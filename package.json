{
  "name": "faceframe",
  "version": "1.0.1",
  "description": "Local face detection and photo organization app",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:1420 && cross-env ELECTRON_START_URL=http://localhost:1420 electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder",
    "test": "node scripts/run-backend-e2e.mjs",
    "test:e2e": "node scripts/run-backend-e2e.mjs",
    "test:unit": "vitest run",
    "test:e2e:v3": "node scripts/run-backend-e2e.mjs v3",
    "test:py": "node scripts/run-py-tests.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.faceframe.desktop",
    "productName": "FaceFrame",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "python-backend",
        "to": "python-backend",
        "filter": [
          "**/*.py",
          "requirements.txt",
          "!tests/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.photography",
      "icon": "resources/icon.png"
    }
  }
}
