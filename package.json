{
  "name": "faceframe",
  "version": "0.2.0",
  "description": "Local face detection and photo organization app",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:1420 && cross-env ELECTRON_START_URL=http://localhost:1420 electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder",
    "test": "node scripts/run-backend-e2e.mjs",
    "test:e2e": "node scripts/run-backend-e2e.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.faceframe.desktop",
    "productName": "FaceFrame",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "python-backend",
        "to": "python-backend",
        "filter": [
          "**/*.py",
          "requirements.txt"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.photography"
    }
  }
}
